{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "outerbase-studio",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // The static-assets cache in open-next.config.ts requires no KV namespace.
  // If switching to the KV cache, create your own namespace and add:
  // { "binding": "NEXT_INC_CACHE_KV", "id": "<your-namespace-id>" }
  "kv_namespaces": []
}
